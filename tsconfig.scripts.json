{
  "extends": "./tsconfig.json",
  "include": [
    "site.config.ts",
    "src/**/*.ts",
    "scripts/**/*.ts",
    ".astro/types.d.ts"
  ],
  "exclude": ["node_modules", "dist", "artifacts", "output"],
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true
  }
}
