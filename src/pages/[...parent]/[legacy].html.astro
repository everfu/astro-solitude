---
import { getRoutes } from '../../lib/routes';
import EntryPage from '../../layouts/EntryPage.astro';
export async function getStaticPaths() {
  return (await getRoutes())
    .filter((r) => r.path.endsWith('.html'))
    .map((route) => ({
      params: {
        parent:
          decodeURI(route.path).slice(1).split('/').slice(0, -1).join('/') ||
          undefined,
        legacy: decodeURI(route.path).split('/').pop()!.slice(0, -5),
      },
      props: { route },
    }));
}
const { route } = Astro.props;
---

<EntryPage route={route} />
