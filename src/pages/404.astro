---
import Base from '../layouts/Base.astro';
import { cfg, t, url } from '../lib/site';
import { getPosts, contentPath } from '../lib/content';
const posts = await getPosts();
---

<Base title={t('pageNotFound')} type="404">
  <main id="content-inner" class="tw:[.layout&]:relative">
    <div id="error-wrap" aria-labelledby="error-page-title" class="tw:[#body-wrap.error_&]:flex tw:[#body-wrap.error_&]:justify-center tw:[#body-wrap.error_&]:relative">
      <div class="error-content tw:[#body-wrap.error_#error-wrap_&]:flex tw:[#body-wrap.error_#error-wrap_&]:flex-row tw:[#body-wrap.error_#error-wrap_&]:justify-center tw:[#body-wrap.error_#error-wrap_&]:items-center tw:[#body-wrap.error_#error-wrap_&]:relative">
        <div
          class="error-img"
          style={{ backgroundImage: `url('${url(cfg.errorpage.img)}')` }}
          aria-hidden="true"
        />
        <div class="error-info tw:[#body-wrap.error_#error-wrap_.error-content_&]:text-center">
          <h1 class="error_title" id="error-page-title">
            404
          </h1>
          <div class="error_subtitle">{cfg.errorpage.text}</div>
          <a class="button--animated" href={url('/')}>
            <i class="solitude fas fa-arrow-up-right-from-square" />
            {t('backHome')}
          </a>
        </div>
      </div>
    </div>
  </main>
  {cfg.errorpage.recommendList && (
    <section class="aside-list tw:[#console_&]:flex tw:[#console_&]:flex-wrap tw:[#console_&]:flex-row tw:[#console_&]:justify-between tw:[#body-wrap.error_&]:flex tw:[#body-wrap.error_&]:flex-row" aria-label={t('recentPosts')}>
      <div class="aside-list-group tw:[#body-wrap.error_.aside-list_&]:flex tw:[#body-wrap.error_.aside-list_&]:flex-row tw:[#body-wrap.error_.aside-list_&]:flex-wrap tw:[#body-wrap.error_.aside-list_&]:justify-between">
        {posts.slice(0, 5).map((p) => (
          <article class="aside-list-item">
            <a class="thumbnail" href={url(contentPath(p))}>
              <img
                src={url(p.data.cover ?? cfg.post.default.cover[0])}
                alt={p.data.title}
                loading="lazy"
              />
            </a>
            <div class="content">
              <a class="title" href={url(contentPath(p))}>
                {p.data.title}
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}
</Base>
