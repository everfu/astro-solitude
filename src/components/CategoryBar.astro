---
import { t, url } from '../lib/site';
import { taxonomy, type Post } from '../lib/content';
interface Props {
  posts: Post[];
  home?: boolean;
}
const { posts, home = false } = Astro.props;
const categories = taxonomy(posts, 'categories');
---

<div
  id="category-bar"
  class="tw:relative tw:flex tw:items-center tw:justify-between tw:overflow-hidden tw:whitespace-nowrap"
>
  <div class:list={['category-bar-items', { home }]} id="category-bar-items">
    <div
      class:list={['category-bar-item', { select: home }]}
      id="category-bar-home"
      data-default-order="0"
    >
      <a href={url('/')}>
        <span class="category-bar-link-icon tw:inline-flex tw:items-center tw:justify-center">
          <i class="solitude fas fa-star" />
        </span>
        <span>{t('home')}</span>
      </a>
    </div>
    <div class="category-bar-item" id="archives" data-default-order="1">
      <a href={url('/archives/')}>
        <span class="category-bar-link-icon tw:inline-flex tw:items-center tw:justify-center">
          <i class="solitude fas fa-book" />
        </span>
        <span>{t('allPosts')}</span>
      </a>
    </div>
    {categories.map((c, i) => (
      <div
        class="category-bar-item"
        id={`category-${c.name}`}
        data-default-order={i + 2}
      >
        <a href={url(c.path)}>{c.name}</a>
      </div>
    ))}
  </div>
  <div class="category-bar-more-group tw:relative tw:flex tw:items-center tw:shrink-0">
    {categories.length > 5 && (
      <button
        class="category-bar-next"
        id="category-bar-next"
        type="button"
        data-solitude-action="scrollCategoryBarToRight"
        aria-label={t('more')}
      >
        <i class="solitude fas fa-angles-right" />
      </button>
    )}
    <a
      class="category-bar-more tw:relative tw:inline-flex tw:items-center tw:justify-center tw:overflow-hidden"
      href={url('/categories/')}
    >
      {t('more')}
    </a>
  </div>
</div>
