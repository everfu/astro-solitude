---
import { cfg, t } from '../lib/site';
const music = cfg.capsule;
---

{music.enable && (
  <div class="needEndHide" id="nav-music" transition:persist="solitude-music">
    <button
      class="music-capsule-hitarea"
      type="button"
      data-solitude-action="handleMusicClick"
      data-solitude-event="true"
      aria-keyshortcuts="ArrowLeft ArrowRight Home End"
      aria-label={t('rightMenuMusicStart')}
    />
    <output class="music-progress-tooltip" aria-hidden="true">
      0:00 / 0:00
    </output>
    <span class="music-progress-status" role="status" aria-live="polite" />
    <div id="nav-music-hoverTips">
      {[
        ['prev', 'musicSkipBack', 'backward-step', 'rightMenuMusicBack'],
        ['pause', 'musicToggle', 'pause', 'rightMenuMusicStop'],
        ['play', 'musicToggle', 'play', 'rightMenuMusicStart'],
        ['next', 'musicSkipForward', 'forward-step', 'rightMenuMusicForward'],
      ].map(([id, action, icon, label]) => (
        <button
          class="music-control-btn"
          id={`music-${id}`}
          type="button"
          data-solitude-action={action}
          data-solitude-stop="true"
          aria-label={t(label)}
        >
          <i class={`solitude fas fa-${icon}`} />
        </button>
      ))}
    </div>
    <meting-js
      id={music.id}
      server={music.server}
      type={music.type}
      mutex="true"
      volume={String(music.volume)}
      preload="none"
      theme="var(--efu-main)"
      data-lrctype="0"
      order="random"
    />
  </div>
)}
