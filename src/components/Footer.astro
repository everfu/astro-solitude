---
import { cfg, config, t, url } from '../lib/site';
const f = cfg.footer;
const year = new Date().getFullYear();
const start = new Date(cfg.aside.siteinfo.runtime).getFullYear();
---

<footer id="footer" class="tw:relative tw:flex tw:flex-col">
  <div
    id="footer_deal"
    class="tw:[#footer_&]:justify-center tw:[#footer_&]:flex tw:[#footer_&]:items-center"
  >
    {f.information.left.map((l) => (
      <a
        class="deal_link tw:[#footer_#footer\_deal_&]:flex tw:[#footer_#footer\_deal_&]:justify-center tw:[#footer_#footer\_deal_&]:items-center"
        href={url(l.url)}
        title={l.name}
        aria-label={l.name}
      >
        <i class={`solitude ${l.icon}`} />
      </a>
    ))}
    {f.information.author && (
      <button
        class="footer_mini_logo nolazyload tw:[#footer_#footer\_deal_&]:cursor-pointer tw:[#footer_#footer\_deal_&]:overflow-hidden"
        id="footer_mini_logo"
        type="button"
        data-solitude-action="toTop"
        aria-label={t('backTop')}
      >
        <img src={url(f.information.author)} alt="" />
      </button>
    )}
    {f.information.right.map((l) => (
      <a
        class="deal_link tw:[#footer_#footer\_deal_&]:flex tw:[#footer_#footer\_deal_&]:justify-center tw:[#footer_#footer\_deal_&]:items-center"
        href={url(l.url)}
        title={l.name}
        aria-label={l.name}
      >
        <i class={`solitude ${l.icon}`} />
      </a>
    ))}
  </div>
  <div
    id="st-footer"
    class="tw:[#footer_&]:flex tw:[#footer_&]:flex-row tw:[#footer_&]:flex-wrap"
  >
    {Object.entries(f.group)
      .sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0))
      .map(([name, items]) => (
        <div class="footer-group">
          <h3 class="footer-title">{name}</h3>
          <div class="footer-links tw:[#footer_#st-footer_&]:flex tw:[#footer_#st-footer_&]:flex-col">
            {items.map((l) => (
              <a class="footer-item" href={url(l.url)}>
                {l.name}
              </a>
            ))}
          </div>
        </div>
      ))}
    {f.randomlink && (
      <div class="footer-group">
        <div class="footer-title-group tw:[#footer_#st-footer_&]:flex tw:[#footer_#st-footer_&]:items-center">
          <h3 class="footer-title">{t('randomFriends')}</h3>
          <button
            class="random-friends-btn tw:[#footer_#st-footer_&]:flex"
            type="button"
            data-solitude-action="randomLinksList"
            aria-label={t('randomFriends')}
          >
            <i class="solitude fas fa-arrows-rotate" />
          </button>
        </div>
        <div
          class="footer-links tw:[#footer_#st-footer_&]:flex tw:[#footer_#st-footer_&]:flex-col"
          id="friend-links-in-footer"
        />
      </div>
    )}
  </div>
  <div id="footer-bar" class="tw:flex tw:overflow-hidden">
    <div class="footer-bar-links tw:[#footer-bar_&]:flex tw:[#footer-bar_&]:justify-between tw:[#footer-bar_&]:flex-wrap tw:[#footer-bar_&]:items-center">
      <div class="footer-bar-left tw:[#footer-bar_&]:flex tw:[#footer-bar_&]:flex-col">
        <div class="copyright tw:[#footer-bar_.footer-bar-left_&]:flex tw:[#footer-bar_.footer-bar-left_&]:flex-row tw:[#footer-bar_.footer-bar-left_&]:items-center">
          © {start === year ? year : `${start} – ${year}`} By{' '}
          <a
            class="footer-bar-link tw:[#footer-bar_.footer-bar-left_.beian-group_&]:flex tw:[#footer-bar_.footer-bar-left_.beian-group_&]:items-center tw:[#footer-bar_&]:whitespace-nowrap tw:[#footer-bar_&]:flex tw:[#footer-bar_&]:items-center"
            href={url('/')}
          >
            <img
              class="author-avatar tw:[#sidebar_#sidebar-menus_>_&]:text-center"
              src={url(cfg.site.icon)}
              alt=""
            />
            {config.author.name}
          </a>
        </div>
        <div class="beian-group tw:[#footer-bar_.footer-bar-left_&]:flex tw:[#footer-bar_.footer-bar-left_&]:flex-wrap">
          {f.beian.map((l) => (
            <a
              class="footer-bar-link tw:[#footer-bar_.footer-bar-left_.beian-group_&]:flex tw:[#footer-bar_.footer-bar-left_.beian-group_&]:items-center tw:[#footer-bar_&]:whitespace-nowrap tw:[#footer-bar_&]:flex tw:[#footer-bar_&]:items-center"
              href={l.url}
            >
              {l.icon && <img class="beian-icon" src={url(l.icon)} alt="" />}
              <span class="beian-name">{l.name}</span>
            </a>
          ))}
          <a
            class="footer-bar-link tw:[#footer-bar_.footer-bar-left_.beian-group_&]:flex tw:[#footer-bar_.footer-bar-left_.beian-group_&]:items-center tw:[#footer-bar_&]:whitespace-nowrap tw:[#footer-bar_&]:flex tw:[#footer-bar_&]:items-center"
            href="https://astro.build/"
            target="_blank"
            rel="noopener noreferrer"
          >
            {t('frameworkBy')} Astro
          </a>
          <a
            class="footer-bar-link tw:[#footer-bar_.footer-bar-left_.beian-group_&]:flex tw:[#footer-bar_.footer-bar-left_.beian-group_&]:items-center tw:[#footer-bar_&]:whitespace-nowrap tw:[#footer-bar_&]:flex tw:[#footer-bar_&]:items-center"
            href="https://github.com/everfu/astro-solitude"
            target="_blank"
            rel="noopener noreferrer"
          >
            {t('themeBy')} Solitude
          </a>
        </div>
      </div>
      <div class="footer-bar-right tw:[#footer-bar_&]:flex tw:[#footer-bar_&]:flex-row tw:[#footer-bar_&]:flex-wrap tw:[#footer-bar_&]:items-center">
        {f.links.map((l) => (
          <a
            class="footer-bar-link tw:[#footer-bar_.footer-bar-left_.beian-group_&]:flex tw:[#footer-bar_.footer-bar-left_.beian-group_&]:items-center tw:[#footer-bar_&]:whitespace-nowrap tw:[#footer-bar_&]:flex tw:[#footer-bar_&]:items-center"
            href={url(l.url)}
            title={l.name}
          >
            {l.icon ? (
              (Array.isArray(l.icon) ? l.icon : [l.icon]).map(
                (icon: string) => <i class={`solitude ${icon}`} />,
              )
            ) : l.img ? (
              <img src={url(l.img)} alt={l.name} />
            ) : (
              l.name
            )}
          </a>
        ))}
      </div>
    </div>
  </div>
  {cfg.comment.use && cfg.comment.commentBarrage && (
    <div class="comment-barrage needEndHide" />
  )}
</footer>
