---
import katex from 'katex';
interface Props {
  code: string;
  display?: string | boolean;
}
const { code, display = false } = Astro.props;
const block = display === true || display === 'true';
const Tag = block ? 'div' : 'span';
const html = katex.renderToString(code, {
  displayMode: block,
  throwOnError: false,
  trust: false,
});
---

<Tag class="solitude-math" set:html={html} />
