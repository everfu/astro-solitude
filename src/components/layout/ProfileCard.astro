---
import Icon from '@/components/Icon.astro';
import { cfg, config, url } from '@/lib/site';

const card = cfg.aside.my_card;
const avatar =
  card.author.img === '/img/logo.png'
    ? '/img/brand/profile-avatar.webp'
    : card.author.img;
---

<div class="card-widget card-profile">
  <div class="profile-content">
    <div class="profile-header">
      <button
        class="profile-greeting"
        id="sayhi"
        type="button"
        data-solitude-action="changeWittyWord"
      >
        {config.author.name}
      </button>
      <Icon name="lucide:moon" class="profile-moon" aria-hidden="true" />
    </div>

    <div class="profile-identity">
      <div class="profile-avatar">
        <img
          class="profile-portrait"
          src={url(avatar)}
          alt={config.author.name}
          width="88"
          height="88"
          loading="lazy"
        />
        {card.author.emoji ? (
          <span
            class="profile-sticker profile-sticker-emoji"
            aria-hidden="true"
          >
            {card.author.emoji}
          </span>
        ) : (
          card.author.sticker && (
            <span class="profile-sticker" aria-hidden="true">
              <img src={url(card.author.sticker)} alt="" loading="lazy" />
            </span>
          )
        )}
      </div>
      <div class="profile-author">
        <h2 class="profile-name">{config.author.name}</h2>
        <div class="profile-bio" set:html={card.description} />
      </div>
    </div>

    <div class="profile-description" set:html={card.content} />

    {card.information.length > 0 && (
      <div class="profile-socials">
        {card.information.map((link) => (
          <a class="profile-social" href={url(link.url)} title={link.name}>
            {link.icon && <Icon name={link.icon} aria-hidden="true" />}
            <span>{link.name}</span>
          </a>
        ))}
      </div>
    )}
  </div>
</div>

<style>
  @layer solitude.components {
    :global(#aside-content) .card-profile {
      --profile-card-background: var(--current-banner-theme, var(--efu-theme));
      --profile-card-text-color: var(--efu-nav-hover-text);
      position: relative;
      overflow: hidden;
      color: var(--profile-card-text-color);
      background: var(--profile-card-background);
      border: 1px solid
        color-mix(
          in srgb,
          var(--profile-card-text-color) 18%,
          var(--profile-card-background)
        );
      box-shadow:
        0 8px 24px rgb(0 0 0 / 8%),
        inset 0 1px 0 rgb(255 255 255 / 8%);
    }

    .profile-content {
      position: relative;
      display: flex;
      flex-direction: column;
      min-height: 320px;
      padding: 22px 24px;
    }

    .profile-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .profile-greeting {
      min-width: 0;
      padding: 0;
      border: 0;
      color: color-mix(
        in srgb,
        var(--profile-card-text-color) 75%,
        transparent
      );
      background: transparent;
      font: inherit;
      font-size: 13px;
      line-height: 1.5;
      text-align: left;
      overflow-wrap: anywhere;
      cursor: pointer;
      transition: color var(--efu-motion-fast);
    }

    .profile-greeting:hover {
      color: var(--profile-card-text-color);
    }

    .profile-moon {
      flex: 0 0 auto;
      color: var(--profile-card-text-color);
      font-size: 18px;
    }

    .profile-identity {
      display: grid;
      grid-template-columns: 88px minmax(0, 1fr);
      align-items: center;
      gap: 16px;
      margin-top: 27px;
    }

    .profile-avatar {
      position: relative;
      width: 88px;
      height: 88px;
    }

    .profile-portrait {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      border: 2px solid #f5f3ff;
      border-radius: 50%;
      filter: none;
    }

    .profile-sticker {
      position: absolute;
      right: -2px;
      bottom: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 26px;
      height: 26px;
      overflow: hidden;
      border: 2px solid var(--profile-card-background);
      border-radius: 50%;
      background: #fff;
    }

    .profile-sticker img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .profile-sticker-emoji {
      font-size: 16px;
      line-height: 1;
    }

    .profile-author {
      min-width: 0;
    }

    .profile-name {
      margin: 0 0 6px;
      color: var(--profile-card-text-color);
      font-size: 24px;
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: -0.6px;
      overflow-wrap: anywhere;
    }

    .profile-bio {
      color: color-mix(
        in srgb,
        var(--profile-card-text-color) 75%,
        transparent
      );
      font-size: 13px;
      line-height: 1.45;
      overflow-wrap: anywhere;
    }

    .profile-description {
      max-width: 210px;
      margin: 23px 0 25px;
      color: var(--profile-card-text-color);
      font-size: 17px;
      line-height: 1.45;
      overflow-wrap: anywhere;
    }

    .profile-socials {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px 18px;
      margin-top: auto;
      padding-top: 14px;
      border-top: 1px solid
        color-mix(in srgb, var(--profile-card-text-color) 25%, transparent);
    }

    .profile-social {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
      max-width: 100%;
      min-height: 28px;
      color: var(--profile-card-text-color);
      font-size: 14px;
      line-height: 1.5;
      overflow-wrap: anywhere;
      transition: color var(--efu-motion-fast);
    }

    .profile-social :global(.solitude-icon) {
      flex: 0 0 auto;
      font-size: 20px;
    }

    .profile-social:hover {
      color: color-mix(
        in srgb,
        var(--profile-card-text-color) 70%,
        transparent
      );
    }

    .profile-greeting:focus-visible,
    .profile-social:focus-visible {
      outline: 2px solid var(--profile-card-text-color);
      outline-offset: 5px;
      border-radius: 3px;
    }

    .profile-bio :global(> :first-child),
    .profile-description :global(> :first-child) {
      margin-top: 0;
    }

    .profile-bio :global(> :last-child),
    .profile-description :global(> :last-child) {
      margin-bottom: 0;
    }
  }
</style>
