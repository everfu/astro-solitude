---
import { url, t } from '../lib/site';
import { pageRange } from '../lib/pagination';
interface Props {
  current: number;
  total: number;
  base?: string;
}
const { current, total, base = '' } = Astro.props;
const href = (n: number) => url(n === 1 ? `${base}/` : `${base}/page/${n}/`);
---

{total > 1 && (
  <nav id="pagination" aria-label={t('paginationNavigation')}>
    <div class="pagination">
      {current > 1 && (
        <a
          class="extend prev"
          href={href(current - 1)}
          aria-label={t('previousPage')}
        >
          <i class="fas fa-chevron-left" aria-hidden="true" />
          <span class="pagination_tips_prev">{t('previousPageShort')}</span>
        </a>
      )}
      {pageRange(current, total).map((n) =>
        n === 'gap' ? (
          <span class="page-gap" aria-hidden="true">
            …
          </span>
        ) : n === current ? (
          <span class="page-number current" aria-current="page">
            {n}
          </span>
        ) : (
          <a class="page-number" href={href(n)}>
            {n}
          </a>
        ),
      )}
      {current < total && (
        <a
          class="extend next"
          href={href(current + 1)}
          aria-label={t('nextPage')}
        >
          <span class="pagination_tips_next">{t('nextPageShort')}</span>
          <i class="fas fa-chevron-right" aria-hidden="true" />
        </a>
      )}
    </div>
  </nav>
)}
