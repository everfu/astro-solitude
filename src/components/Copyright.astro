---
import { cfg, config, t, url, absolute } from '../lib/site';
import { contentPath, type Post } from '../lib/content';
interface Props {
  post: Post;
}
const { post } = Astro.props;
const p = post.data;
const c = cfg.post.default.copyright;
const author = String(p.author ?? config.author.name);
const avatar = String(p.avatar ?? c.author ?? cfg.site.icon);
const background = String(p.avatar_background ?? c.author_background ?? '');
---

<section class="post-copyright" aria-label={t('copyrightSection')}>
  <div class="post-copyright__author_group">
    <a
      class:list={[
        'post-copyright__author_img',
        { 'post-copyright__author_img--layered': background },
      ]}
      href={url('/about/')}
      aria-label={`${t('author')}: ${author}`}
    >
      {background && (
        <img
          class="post-copyright__author_img_back"
          src={url(background)}
          alt=""
          aria-hidden="true"
        />
      )}
      <img
        class="post-copyright__author_img_front"
        src={url(avatar)}
        alt={author}
      />
    </a>
    <div class="post-copyright__author_name">{author}</div>
    <div class="post-copyright__author_desc">
      {String(p.desc ?? config.description)}
    </div>
  </div>
  {(cfg.post.share.enable || cfg.post.award.enable) && (
    <div class="post-tools" role="group" aria-label={t('copyrightActions')}>
      {cfg.post.share.enable && (
        <div class="post-copyright__share">
          {cfg.post.share.list.map((name: string) =>
            name === 'link' ? (
              <button
                class="post-copyright__share-button"
                type="button"
                data-solitude-action="copy"
                data-solitude-value={absolute(contentPath(post))}
                aria-label={t('copyLink')}
              >
                <i class="solitude fas fa-link" />
              </button>
            ) : (
              <a
                class="post-copyright__share-button"
                href={`https://www.addtoany.com/add_to/${encodeURIComponent(name)}?linkurl=${encodeURIComponent(absolute(contentPath(post)))}`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${t('shareTo')} ${name}`}
              >
                <i class={`solitude fab fa-${name}`} />
              </a>
            ),
          )}
        </div>
      )}
      {cfg.post.award.enable && (
        <details class="reward">
          <summary>{t('reward')}</summary>
          <div class="reward-list">
            {cfg.post.award.list.map((item: any) => (
              <figure>
                <img src={url(item.qrcode)} alt={item.name} />
                <figcaption>{item.name}</figcaption>
              </figure>
            ))}
          </div>
        </details>
      )}
    </div>
  )}
  {(p.copyright ?? c.enable) && (
    <div class="post-copyright__notice">
      <div class="post-copyright-info">
        {p.reprint ? (
          t('copyrightReprint')
        ) : (
          <>
            {t('copyrightOriginalPrefix')}
            <a href={c.licenurl}>{c.license}</a>
            {t('copyrightOriginalMiddle')}
            <a href={url('/')}>{config.title}</a>
            {t('copyrightOriginalSuffix')}
          </>
        )}
      </div>
    </div>
  )}
</section>
