---
export interface Heading {
  depth: number;
  slug: string;
  text: string;
  children: Heading[];
}
interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
---

{headings.map((heading) => (
  <li class={`toc-item toc-level-${heading.depth}`}>
    <a
      class="toc-link tw:[#card-toc_.toc-content_&]:flex tw:[#card-toc_.toc-content_&]:items-center"
      href={`#${heading.slug}`}
    >
      <span class="toc-text">{heading.text}</span>
    </a>
    {heading.children.length > 0 && (
      <ol class="toc-child tw:[#card-toc_.toc-content_.toc-item.active_>_&]:block">
        <Astro.self headings={heading.children} />
      </ol>
    )}
  </li>
))}
