---
import { cfg, config, t, url, dateLabel, isoDate, termPath } from '../lib/site';
import { contentPath, wordCount, type Post } from '../lib/content';
interface Props {
  post: Post;
}
const { post } = Astro.props;
const p = post.data;
const count = wordCount(post.body ?? '');
---

<div
  id="post-info"
  class="tw:[.post_&]:absolute tw:[.post_&]:flex tw:[.post_&]:flex-col tw:[.post_&]:items-start tw:[.post_&]:justify-center"
>
  <div
    id="post-firstinfo"
    class="tw:[.post_#post-info_&]:flex tw:[.post_#post-info_&]:text-left tw:[.post_#post-info_&]:whitespace-nowrap"
  >
    <div class="meta-firstline tw:[.post_#post-info_#post-firstinfo_&]:flex tw:[.post_#post-info_#post-firstinfo_&]:items-center">
      <a class="post-meta-original tw:[.post_#post-info_#post-firstinfo_.meta-firstline_&]:flex">
        {p.reprint ? t('reprint') : t('original')}
      </a>
      {p.categories[0] && (
        <span class="post-meta-categories tw:[.post_#post-info_#post-firstinfo_.meta-firstline_span.post-meta-categories_a&]:flex">
          <a
            class="post-meta-categories tw:[.post_#post-info_#post-firstinfo_.meta-firstline_span.post-meta-categories_a&]:flex"
            href={url(termPath('categories', p.categories[0]))}
          >
            {p.categories[0]}
          </a>
        </span>
      )}
      <div class="tag_share">
        <div class="post-meta__tag-list tw:[.post_#post-info_#post-firstinfo_.meta-firstline_.tag\_share_&]:flex tw:[.post_#post-info_#post-firstinfo_.meta-firstline_.tag\_share_&]:flex-row tw:[.post_#post-info_#post-firstinfo_.meta-firstline_.tag\_share_&]:items-center tw:[#post_.post-tools-right_.tag\_share_&]:flex tw:[#post_.post-tools-right_.tag\_share_&]:flex-wrap tw:[#post_.post-tools-right_.tag\_share_&]:flex-row">
          {p.tags.map((tag) => (
            <a
              class="post-meta__tags tw:[.post_#post-info_#post-firstinfo_.meta-firstline_.tag\_share_.post-meta\_\_tag-list_&]:flex tw:[.post_#post-info_#post-firstinfo_.meta-firstline_.tag\_share_.post-meta\_\_tag-list_&]:flex-row tw:[.post_#post-info_#post-firstinfo_.meta-firstline_.tag\_share_.post-meta\_\_tag-list_&]:items-center tw:[#post_.post-tools-right_.tag\_share_.post-meta\_\_tag-list_&]:flex tw:[#post_.post-tools-right_.tag\_share_.post-meta\_\_tag-list_&]:items-center tw:[#post_.post-tools-right_.tag\_share_.post-meta\_\_tag-list_&]:whitespace-nowrap"
              href={url(termPath('tags', tag))}
            >
              <span class="tags-name tags-punctuation tw:[span&]:flex tw:[span&]:items-center tw:[#post_.post-tools-right_.tag\_share_.post-meta\_\_tag-list_.post-meta\_\_tags_span&]:flex tw:[#post_.post-tools-right_.tag\_share_.post-meta\_\_tag-list_.post-meta\_\_tags_span&]:items-center">
                <i class="solitude fas fa-hashtag" />
                {tag}
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
  <h1 class="post-title tw:[.post_#post-info_&]:overflow-hidden tw:[.post_#post-info_&]:text-left">
    {p.title}
  </h1>
  <div id="post-meta" class="tw:[.post_#post-info_&]:flex">
    <div class="meta-secondline tw:[.post_#post-info_#post-meta_&]:flex tw:[.post_#post-info_#post-meta_&]:flex-row tw:[.post_#post-info_#post-meta_&]:flex-wrap tw:[.post_#post-info_#post-meta_&]:items-center tw:[.post_#post-info_#post-meta_&]:justify-start">
      {cfg.post.meta.wordcount && (
        <span class="post-meta-wordcount">
          <i class="post-meta-icon solitude fas fa-file-word" />
          <span class="word-count">{count}</span>
        </span>
      )}
      {cfg.post.meta.date && (
        <span class="post-meta-date">
          <i class="post-meta-icon solitude fas fa-calendar-days" />
          <time datetime={isoDate(p.date)}>{dateLabel(p.date)}</time>
        </span>
      )}
      {cfg.post.meta.updated && (
        <span class="post-meta-date">
          <i class="post-meta-icon solitude fas fa-arrows-rotate" />
          <time datetime={isoDate(p.lastmod ?? p.date)}>
            {dateLabel(p.lastmod ?? p.date)}
          </time>
        </span>
      )}
      {cfg.post.meta.readtime && (
        <span class="post-meta-readtime">
          <i class="post-meta-icon solitude fas fa-clock" />
          <span>
            {Math.max(
              1,
              Math.ceil(count / (config.hasCJKLanguage ? 500 : 212)),
            )}{' '}
            {t('readingMinutes')}
          </span>
        </span>
      )}
      {cfg.post.meta.locate && (
        <span class="post-meta-position">
          <i class="solitude fas fa-location-dot" />
          <span>{String(p.locate ?? cfg.post.default.locate)}</span>
        </span>
      )}
      {cfg.post.meta.pv &&
        cfg.comment.pv &&
        cfg.valine.visitor &&
        cfg.comment.use.includes('valine') && (
          <span
            class="leancloud_visitors"
            id={url(contentPath(post))}
            data-flag-title={p.title}
          >
            <span class="leancloud-visitors-count">0</span>
          </span>
        )}
      {cfg.post.meta.comment &&
        p.comment &&
        cfg.comment.count &&
        cfg.comment.use && (
          <a href="#post-comment">
            <i class="solitude fas fa-comment" />
            <span
              class="comment-count valine-comment-count"
              data-xid={url(contentPath(post))}
            >
              0
            </span>
          </a>
        )}
    </div>
  </div>
</div>
<div class="post-radius-bottom" />
