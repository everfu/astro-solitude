---
import { cfg, config, t, url, dateLabel, json } from '../../lib/site';
import { contentPath, type Post } from '../../lib/content';
interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
const data = posts.map((p) => ({
  title: p.data.title,
  url: url(contentPath(p)),
  cover: url(p.data.cover ?? cfg.post.default.cover[0]),
  primaryCategory: p.data.categories[0] ?? t('uncategorized'),
  dateLabel: dateLabel(p.data.date),
  year: new Intl.DateTimeFormat('en', {
    timeZone: config.timeZone,
    year: 'numeric',
  }).format(p.data.date),
}));
---

<div
  class="archive-page-shell"
  id="archives-page"
  data-per-page={config.pagination}
  data-initial-year="all"
  data-initial-page="1"
  data-label-error={t('archiveLoadError')}
  data-label-empty={t('archiveEmpty')}
  data-label-uncategorized={t('uncategorized')}
  data-label-previous={t('previousPage')}
  data-label-next={t('nextPage')}
>
  <section class="archive-page-section archive-page-section-toolbar">
    <div class="archive-page-toolbar">
      <div
        class="archive-page-years"
        role="group"
        aria-label={t('archiveYearFilter')}
      >
        <button
          class="archive-year-button is-active"
          type="button"
          data-year="all"
          aria-pressed="true"
        >
          {t('archiveAll')}
        </button>
        <div id="archives-year-filter-list" />
      </div>
    </div>
  </section>
  <section
    class="archive-page-section archive-page-section-list"
    aria-live="polite"
  >
    <div class="archive-page-list" id="archives-page-list">
      {data.slice(0, config.pagination).map((p) => (
        <a class="archive-item" href={p.url}>
          <time>{p.dateLabel}</time> {p.title}
        </a>
      ))}
    </div>
  </section>
  <section class="archive-page-section archive-page-section-pagination">
    <nav id="pagination" aria-label={t('paginationNavigation')}>
      <div class="pagination" />
    </nav>
  </section>
</div>
<template id="archive-page-data" set:html={json(data)} />
