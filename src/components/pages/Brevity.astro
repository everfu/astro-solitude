---
import brevity from '../../data/brevity.json';
import { cfg, config, dateLabel, t, url } from '../../lib/site';
interface Props {
  data?: {
    title?: string;
    items: import('../../lib/page-types').BrevityItem[];
    header?: {
      description?: string;
      cover?: string;
      button?: { text: string; link: string };
    };
  };
}
const data: NonNullable<Props['data']> = Astro.props.data ?? brevity;
const c = cfg.brevity;
const header = data.header;
const items = data.items.slice(0, c.strip);
---

{c.enable && (
  <>
    <header class="author-content author-content-item single sharePage brevity-header tw:relative tw:[.author-content.author-content-item&]:overflow-hidden">
      <img
        class="brevity-header-cover tw:absolute tw:object-cover"
        src={url(header?.cover || '/img/demo/cover-legacy-url-v2.webp')}
        alt=""
        fetchpriority="high"
      />
      <div class="card-content tw:[#aside-content_.card-widget_&]:relative tw:[#aside-content_.card-widget_&]:flex tw:[#aside-content_.card-widget_&]:flex-col tw:[.author-content-item_&]:absolute tw:[.author-content-item_&]:flex tw:[.author-content-item_&]:flex-col">
        <div class="author-content-item-tips">
          {header?.description || t('brevityDescription')}
        </div>
        <h1 class="author-content-item-title tw:[#console_&]:flex tw:[#console_&]:items-center tw:[#console_&]:justify-between tw:[#about-page_.interest-card_&]:flex tw:[#about-page_.interest-card_&]:items-start tw:[#about-page_.interest-card_&]:justify-between tw:[#about-page_.interest-card--media_&]:block">
          {t('brevity')}
        </h1>
        <div class="content-bottom tw:[.author-content-item_&]:flex tw:[.author-content-item_&]:items-center tw:[.author-content-item_&]:justify-between">
          <div class="tips">{config.author.name}</div>
        </div>
        <div class="banner-button-group tw:[div#banners_&]:absolute tw:[div#banners_&]:flex tw:[.author-content-item_.card-content_&]:absolute">
          <a
            class="banner-button tw:[div#banners_&]:flex tw:[div#banners_&]:items-center tw:[div#banners_&]:cursor-pointer tw:[.author-content-item_.card-content_.banner-button-group_&]:justify-center tw:[.author-content-item_.card-content_.banner-button-group_&]:flex tw:[.author-content-item_.card-content_.banner-button-group_&]:items-center tw:[.author-content-item_.card-content_.banner-button-group_&]:cursor-pointer"
            href={url(header?.button?.link || '/archives/')}
            aria-label={header?.button?.text || t('brevityReadMore')}
          >
            <i
              class="solitude fas fa-circle-chevron-right"
              aria-hidden="true"
            />
            <span class="banner-button-text">
              {header?.button?.text || t('brevityReadMore')}
            </span>
          </a>
        </div>
      </div>
    </header>
    <solitude-brevity id="bber" data-style={c.style} class="tw:block">
      <section class="timeline page-1">
        <ul class="list waterfall tw:[#bber_&]:grid tw:[#bber_&]:relative">
          {items.map((item) => (
            <li class="item">
              {c.style === 2 && (
                <div class="meta tw:[#bber_&]:flex tw:[#bber_&]:items-center">
                  <img
                    class="avatar tw:[.card-info_&]:absolute tw:[#bber_&]:object-cover"
                    src={url(cfg.aside.my_card.author.img)}
                    alt=""
                  />
                  <div class="info">
                    <span class="bber_nick">{config.author.name}</span>
                    <time
                      class="bber_date"
                      datetime={item.date.replace(' ', 'T')}
                      title={item.date}
                    >
                      {dateLabel(item.date.replace(' ', 'T'))}
                    </time>
                  </div>
                </div>
              )}
              <div class="bber-content">
                <p class="datacont">{item.content}</p>
                {item.image && (
                  <div class="bber-content-img tw:[#bber_&]:flex">
                    {(Array.isArray(item.image)
                      ? item.image
                      : [item.image]
                    ).map((img) => (
                      <img
                        src={url(typeof img === 'string' ? img : img.url)}
                        alt={
                          typeof img === 'string'
                            ? item.content
                            : (img.alt ?? item.content)
                        }
                        loading="lazy"
                        decoding="async"
                      />
                    ))}
                  </div>
                )}
              </div>
              {c.music && item.aplayer && (
                <div class="bber-music tw:[#bber_&]:overflow-hidden">
                  <solitude-meting
                    server={item.aplayer.server}
                    type="song"
                    id={item.aplayer.id}
                    mutex="true"
                    preload="none"
                    theme="var(--efu-main)"
                    data-lrctype="0"
                  />
                </div>
              )}
              {item.video && (
                <div class="bber-video tw:[#bber_&]:grid">
                  {item.video.player && (
                    <video
                      src={url(item.video.player)}
                      controls
                      preload="metadata"
                    />
                  )}
                  {item.video.bilibili && <iframe
                    src={`https://player.bilibili.com/player.html?autoplay=0&bvid=${encodeURIComponent(item.video.bilibili)}`}
                    title="Bilibili video"
                    loading="lazy"
                    allowfullscreen
                  ></iframe>}
                </div>
              )}
              {(c.style === 1 || item.location || item.link) && (
                <>
                  <hr />
                  <div class="bber-bottom">
                    <div class="bber-info tw:[#bber_&]:flex tw:[#bber_&]:flex-wrap tw:[#bber_&]:items-center">
                      {c.style === 1 && (
                        <div class="bber-info-time">
                          <i class="solitude fas fa-calendar-day" />
                          <time
                            datetime={item.date.replace(' ', 'T')}
                            title={item.date}
                          >
                            {dateLabel(item.date.replace(' ', 'T'))}
                          </time>
                        </div>
                      )}
                      {item.location && (
                        <div class="bber-info-location">
                          <i class="solitude fas fa-location-dot" />
                          {item.location}
                        </div>
                      )}
                      {item.link && (
                        <a class="bber-content-link" href={url(item.link)}>
                          <i class="solitude fas fa-link" />
                          {t('brevityLink')}
                        </a>
                      )}
                    </div>
                  </div>
                </>
              )}
            </li>
          ))}
        </ul>
        <div id="bber-tips" class="tw:text-center">
          {items.length
            ? t('brevityCount').replace('{count}', String(items.length))
            : t('brevityEmpty')}
        </div>
      </section>
    </solitude-brevity>
  </>
)}

<script>
  import '../../scripts/brevity';
</script>
