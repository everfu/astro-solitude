---
import kit from '../../data/kit.json';
import { cfg, url } from '../../lib/site';
interface Props {
  comment?: boolean;
  data?: typeof kit;
}
const { comment = true, data = kit } = Astro.props;
---

<div id="equipment">
  {data.groups.map((g) => (
    <section class="equipment-item">
      <h2 class="equipment-item-title">{g.name}</h2>
      <div class="equipment-item-description">{g.description}</div>
      <div class="equipment-item-content">
        {g.items.map((item: any) => (
          <div class="equipment-item-content-item">
            <div class="equipment-item-content-item-cover">
              <img
                class="equipment-item-content-item-image"
                src={url(item.image ?? '/img/default.avif')}
                alt={item.name}
              />
            </div>
            <div class="equipment-item-content-item-info">
              <div
                class="equipment-item-content-item-name"
                role="button"
                tabindex="0"
                data-solitude-action="copy"
                data-solitude-value={item.name}
                aria-label={`复制装备名称：${item.name}`}
              >
                {item.name}
              </div>
              <div class="equipment-item-content-item-specification">
                {item.specification}
              </div>
              <div class="equipment-item-content-item-description">
                {item.description}
              </div>
              <div class="equipment-item-content-item-toolbar">
                {item.link && (
                  <a
                    class="equipment-item-content-item-link"
                    href={item.link}
                    rel="external nofollow noreferrer"
                    target="_blank"
                  >
                    详情
                  </a>
                )}
                {cfg.comment.use && comment && (
                  <a
                    class="bber-reply"
                    role="button"
                    tabindex="0"
                    data-solitude-action="toTalk"
                    data-solitude-value={item.description}
                    aria-label="引用这件装备并评论"
                  >
                    <i class="solitude fas fa-comment" />
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}
</div>
