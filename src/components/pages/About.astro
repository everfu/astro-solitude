---
import about from '../../data/about.json';
import { url, json } from '../../lib/site';
import { marked } from 'marked';
interface Props {
  data?: { title?: string; sections: any[] };
}
const { data = about } = Astro.props;
const allowed = [
  'intro',
  'skills_career',
  'personality_photo',
  'values',
  'interests',
  'stats_profile',
  'story',
];
if (!Array.isArray(data.sections))
  throw new Error('About data requires sections');
for (const section of data.sections)
  if (section.enabled !== false && !allowed.includes(section.type))
    throw new Error(`Unknown About section: ${section.type}`);
---

<section id="about-page" aria-labelledby="about-page-title">
  <h1 class="about-page-title" id="about-page-title">
    {data.title}
  </h1>
  <div class="author-page-content">
    {data.sections
      .filter((s) => s.enabled !== false)
      .map((s: any) => (
        <>
          {s.type === 'intro' && (
            <div class="author-content about-row about-row--intro">
              <article class="author-content-item about-intro-card">
                <p class="about-card-copy">{s.greeting}</p>
                <h2>
                  {s.name_prefix} <span class="inline-word">{s.name}</span>
                </h2>
                <p class="about-card-copy">{s.description}</p>
              </article>
              <article class="author-content-item about-pursuit-card">
                <p class="author-content-item-tips">{s.pursuit?.label}</p>
                <h2>
                  {s.pursuit?.lines?.map((line: string) => (
                    <span>{line}</span>
                  ))}
                  <span class="about-word-mask" aria-live="polite">
                    {s.pursuit?.rotating_words?.map(
                      (word: string, i: number) => (
                        <span
                          data-about-word
                          data-show={i === 0 ? '' : undefined}
                        >
                          {word}
                        </span>
                      ),
                    )}
                  </span>
                </h2>
              </article>
            </div>
          )}
          {s.type === 'skills_career' && (
            <div class="author-content about-row about-row--skills-career">
              <article class="author-content-item skills" tabindex="0">
                <div class="about-card-flow">
                  <p class="author-content-item-tips">{s.skills?.label}</p>
                  <h2 class="author-content-item-title">{s.skills?.title}</h2>
                  <div class="skills-style-group">
                    <div class="skills-marquee" aria-hidden="true">
                      {[0, 1].map(() => (
                        <div class="skills-marquee-track">
                          {[0, 1].map(() => (
                            <div class="skills-marquee-set">
                              {s.skills?.items?.map((item: any) => (
                                <span
                                  class="skills-marquee-icon"
                                  style={`--skill-color:${item.color ?? 'var(--efu-main)'}`}
                                >
                                  {item.image ? (
                                    <img src={url(item.image)} alt="" />
                                  ) : (
                                    <i class={item.icon ?? 'fas fa-code'} />
                                  )}
                                </span>
                              ))}
                            </div>
                          ))}
                        </div>
                      ))}
                    </div>
                    <ul class="skills-list" aria-label={s.skills?.label}>
                      {s.skills?.items?.map((item: any) => (
                        <li class="skill-info">
                          <span
                            class="skill-icon"
                            style={`--skill-color:${item.color ?? 'var(--efu-main)'}`}
                          >
                            {item.image ? (
                              <img src={url(item.image)} alt="" />
                            ) : (
                              <i class={item.icon ?? 'fas fa-code'} />
                            )}
                          </span>
                          <span class="skill-name">{item.name}</span>
                        </li>
                      ))}
                      <li
                        class="skill-info skill-info--more"
                        aria-hidden="true"
                      >
                        …
                      </li>
                    </ul>
                  </div>
                </div>
              </article>
              <article class="author-content-item careers">
                <div class="about-card-flow">
                  <p class="author-content-item-tips">{s.career?.label}</p>
                  <h2 class="author-content-item-title">{s.career?.title}</h2>
                  <ul class="careers-summary">
                    {s.career?.summary?.map((item: any) => (
                      <li
                        style={`--career-color:${item.color ?? 'var(--efu-main)'}`}
                      >
                        <span aria-hidden="true" />
                        {item.name}
                      </li>
                    ))}
                  </ul>
                  {s.career?.timeline && (
                    <div
                      class="career-timeline"
                      style={`--career-track-color:${s.career.timeline.events?.[0]?.color ?? 'var(--efu-main)'}`}
                      role="group"
                      aria-label={
                        s.career.timeline.aria_label ?? s.career.title
                      }
                    >
                      <p class="career-track-label">
                        {s.career.timeline.track_label ?? s.career.label}
                      </p>
                      <div class="career-timeline-axis" aria-hidden="true" />
                      <i class="career-timeline-tick career-timeline-tick--start" />
                      <i class="career-timeline-tick career-timeline-tick--end" />
                      <ul class="career-track" aria-label="生涯阶段">
                        {s.career.timeline.events?.map((event: any) => (
                          <li
                            class:list={[
                              'career-event',
                              { 'career-event--point': !event.to },
                            ]}
                            style={`--career-left:${(100 * (event.from - s.career.timeline.start)) / (s.career.timeline.end - s.career.timeline.start || 1)}%;--career-width:${(100 * ((event.to ?? event.from) - event.from)) / (s.career.timeline.end - s.career.timeline.start || 1)}%;--career-color:${event.color ?? 'var(--efu-main)'}`}
                            tabindex="0"
                            aria-label={`${event.label}，${event.period ?? `${event.from} — ${event.to ?? event.from}`}`}
                          >
                            <span class="career-event-bar" aria-hidden="true" />
                          </li>
                        ))}
                      </ul>
                      <div class="career-timeline-years" aria-hidden="true">
                        <span>
                          {s.career.timeline.start_label ??
                            s.career.timeline.start}
                        </span>
                        <span>
                          {s.career.timeline.end_label ?? s.career.timeline.end}
                        </span>
                      </div>
                    </div>
                  )}
                </div>
              </article>
            </div>
          )}
          {s.type === 'personality_photo' && (
            <div class="author-content about-row about-row--personality-photo">
              <article class="author-content-item personalities">
                <p class="author-content-item-tips">{s.personality?.label}</p>
                <h2 class="author-content-item-title">
                  {s.personality?.title}
                </h2>
                <p
                  class="personality-type"
                  style={`--personality-color:${s.personality?.color ?? 'var(--efu-main)'}`}
                >
                  {s.personality?.type}
                </p>
                {s.personality?.image && (
                  <img
                    class="personality-image nolazyload"
                    src={url(s.personality.image)}
                    alt={s.personality.image_alt ?? ''}
                  />
                )}{' '}
                {s.personality?.link && (
                  <a
                    class="personality-link"
                    href={url(s.personality.link.url)}
                    target={s.personality.link.external ? '_blank' : undefined}
                    rel="noopener noreferrer"
                  >
                    {s.personality.link.text}
                  </a>
                )}
              </article>
              {s.photo && (
                <figure class="author-content-item myphoto" tabindex="0">
                  <img
                    class="author-content-img nolazyload"
                    src={url(s.photo.image)}
                    alt={s.photo.alt ?? ''}
                  />
                  {s.photo.badge && (
                    <img
                      class="myphoto-badge nolazyload"
                      src={url(s.photo.badge)}
                      alt=""
                    />
                  )}
                </figure>
              )}
            </div>
          )}
          {s.type === 'values' && (
            <div class="author-content about-row about-row--values">
              <article class="author-content-item maxim">
                <p class="author-content-item-tips">{s.motto?.label}</p>
                <h2>
                  <span>{s.motto?.prefix}</span>
                  <span>{s.motto?.content}</span>
                </h2>
              </article>
              <article class="author-content-item buff">
                <p class="author-content-item-tips">{s.expertise?.label}</p>
                <h2>
                  <span>
                    {s.expertise?.prefix}
                    <strong>{s.expertise?.specialist}</strong>
                  </span>
                  <span>
                    {s.expertise?.content} <strong>{s.expertise?.level}</strong>
                  </span>
                </h2>
              </article>
            </div>
          )}
          {s.type === 'interests' && (
            <div class="author-content about-row about-row--interests">
              {s.items?.map((item: any) => (
                <article
                  class={`author-content-item interest-card interest-card--${item.variant ?? 'media'}`}
                  tabindex="0"
                  style={`--interest-background:url('${url(item.background)}');--interest-color:${item.color ?? 'var(--efu-main)'}`}
                >
                  <div class="interest-card-content">
                    <p class="author-content-item-tips">{item.label}</p>
                    <h2 class="author-content-item-title">
                      {(item.title_lines ?? [item.title]).map(
                        (line: string) => (
                          <span>{line}</span>
                        ),
                      )}
                      {item.mode?.image && (
                        <img
                          class="interest-mode-image"
                          src={url(item.mode.image)}
                          alt={item.mode.name}
                          title={item.mode.tooltip ?? item.mode.name}
                        />
                      )}
                    </h2>
                    <div class="interest-card-footer">
                      {item.heroes && (
                        <ul class="interest-heroes" aria-label="擅长英雄">
                          {item.heroes.map((hero: any, i: number) => (
                            <li style={`--hero-index:${i}`}>
                              <img
                                src={url(hero.image)}
                                alt={hero.name}
                                title={hero.name}
                              />
                            </li>
                          ))}
                        </ul>
                      )}
                      <p class="interest-subtitle">{item.subtitle}</p>
                      <p class="interest-right-text" title={item.right_tip}>
                        {item.right_text}
                      </p>
                      {item.button && (
                        <a
                          class="about-card-button"
                          href={url(item.button.url)}
                          target={item.button.external ? '_blank' : undefined}
                          rel="noopener noreferrer"
                        >
                          {item.button.icon && <i class={item.button.icon} />}
                          <span>{item.button.text}</span>
                        </a>
                      )}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          )}
          {s.type === 'stats_profile' && (
            <div class="author-content about-row about-row--stats-profile">
              <article
                class="author-content-item about-statistics"
                data-about-stats
                style={
                  s.statistics?.background
                    ? `--statistics-background:url('${url(s.statistics.background)}')`
                    : undefined
                }
              >
                <p class="author-content-item-tips">{s.statistics?.label}</p>
                <h2 class="author-content-item-title">{s.statistics?.title}</h2>
                <dl class="about-statistics-list">
                  {s.statistics?.metrics?.map((m: any) => (
                    <div>
                      <dt>{m.label}</dt>
                      <dd data-about-metric={m.field}>{m.fallback}</dd>
                    </div>
                  ))}
                </dl>
                {s.statistics?.button && (
                  <a
                    class="about-card-button"
                    href={url(s.statistics.button.url)}
                  >
                    {s.statistics.button.text}
                  </a>
                )}
                <script
                  is:inline
                  type="application/json"
                  data-about-stats-config
                  set:html={json({
                    source: s.statistics?.source,
                    metrics: s.statistics?.metrics,
                  })}
                ></script>
              </article>
              <article class="author-content-item about-map" tabindex="0">
                <p class="author-content-item-tips">{s.location?.label}</p>
                <h2 class="author-content-item-title">{s.location?.title}</h2>
                <div class="about-map-visual" aria-hidden="true">
                  {s.location?.map_light && (
                    <img
                      class="about-map-image about-map-image--light"
                      src={url(s.location.map_light)}
                      alt=""
                    />
                  )}
                  {s.location?.map_dark && (
                    <img
                      class="about-map-image about-map-image--dark"
                      src={url(s.location.map_dark)}
                      alt=""
                    />
                  )}
                </div>
              </article>
              <article class="author-content-item about-profile">
                <p class="author-content-item-tips">{s.profile?.label}</p>
                <h2 class="author-content-item-title">{s.profile?.title}</h2>
                <dl class="about-profile-list">
                  {s.profile?.items?.map((item: any) => (
                    <div>
                      {item.icon && <i class={item.icon} />}
                      <dt>{item.label}</dt>
                      <dd>{item.value}</dd>
                    </div>
                  ))}
                </dl>
              </article>
            </div>
          )}
          {s.type === 'story' && (
            <article class="author-content-item about-story">
              <p class="author-content-item-tips">{s.label}</p>
              <h2 class="author-content-item-title">{s.title}</h2>
              <div
                class="about-story-content"
                set:html={marked.parse(s.content ?? '')}
              />
            </article>
          )}
        </>
      ))}
  </div>
</section>
