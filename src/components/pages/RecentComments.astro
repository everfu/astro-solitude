---
import { cfg, t, url } from '../../lib/site';
interface Props {
  title: string;
  page?: import('../../lib/page-types').PageMetadata;
}
const { title, page = {} } = Astro.props;
const cover = page.cover || '/img/demo/cover-pagination-v2.webp';
const tip = page.desc || page.description;
---

{cfg.recent_comments.enable && cfg.comment.use && (
  <>
    <section
      class="author-content author-content-item single sharePage tw:[.author-content.author-content-item&]:overflow-hidden"
      style={{
        background: `url(${JSON.stringify(url(cover))}) no-repeat center`,
        backgroundSize: 'cover',
      }}
    >
      <div class="card-content tw:[#aside-content_.card-widget_&]:relative tw:[#aside-content_.card-widget_&]:flex tw:[#aside-content_.card-widget_&]:flex-col tw:[.author-content-item_&]:absolute tw:[.author-content-item_&]:flex tw:[.author-content-item_&]:flex-col">
        {tip && <div class="author-content-item-tips">{tip}</div>}
        <span class="author-content-item-title tw:[#console_&]:flex tw:[#console_&]:items-center tw:[#console_&]:justify-between tw:[#about-page_.interest-card_&]:flex tw:[#about-page_.interest-card_&]:items-start tw:[#about-page_.interest-card_&]:justify-between tw:[#about-page_.interest-card--media_&]:block">
          {title}
        </span>
        {(page.leftend || page.rightend) && (
          <div class="content-bottom tw:[.author-content-item_&]:flex tw:[.author-content-item_&]:items-center tw:[.author-content-item_&]:justify-between">
            {page.leftend && <span class="tips">{page.leftend}</span>}
            {page.rightend && <span class="tips">{page.rightend}</span>}
          </div>
        )}
        {page.rightbtn && page.rightbtnlink && (
          <div class="banner-button-group tw:[div#banners_&]:absolute tw:[div#banners_&]:flex tw:[.author-content-item_.card-content_&]:absolute">
            <a
              class="banner-button tw:[div#banners_&]:flex tw:[div#banners_&]:items-center tw:[div#banners_&]:cursor-pointer tw:[.author-content-item_.card-content_.banner-button-group_&]:justify-center tw:[.author-content-item_.card-content_.banner-button-group_&]:flex tw:[.author-content-item_.card-content_.banner-button-group_&]:items-center tw:[.author-content-item_.card-content_.banner-button-group_&]:cursor-pointer"
              href={url(page.rightbtnlink)}
            >
              <i
                class="solitude fas fa-circle-chevron-right"
                aria-hidden="true"
              />
              <span class="banner-button-text">{page.rightbtn}</span>
            </a>
          </div>
        )}
      </div>
    </section>
    <div
      class="console_recentcomments recent-comments-list tw:[div&]:flex tw:[div&]:flex-wrap"
      data-comment-provider={cfg.comment.use.toLowerCase()}
      aria-live="polite"
      aria-busy="true"
    >
      {t('commentsLoading')}
    </div>
  </>
)}
