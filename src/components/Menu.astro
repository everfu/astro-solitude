---
import { config, url } from '../lib/site';
---

<div class="menus_items tw:[#nav_&]:relative tw:[#nav_&]:text-center tw:[#nav_&]:flex tw:[#nav_&]:flex-row tw:[#nav_&]:justify-center tw:[#nav_&]:box-border">
  {config.menus.map((item) => (
    <div class="menus_item tw:[#nav_.menus\_items_&]:flex tw:[#nav_.menus\_items_&]:flex-col tw:[#nav_.menus\_items_&]:items-center tw:[#nav_.menus\_items_&]:relative">
      <a
        class="site-page tw:[#nav_&]:relative tw:[#nav_&]:cursor-pointer tw:[#sidebar_#sidebar-menus_.menus\_items_&]:relative tw:[#sidebar_#sidebar-menus_.menus\_items_&]:block tw:[#sidebar_#sidebar-menus_.menus\_items_&]:cursor-pointer tw:[#sidebar_#sidebar-menus_.menus\_items_.menus\_item_>_&]:flex"
        href={item.children || item.action ? '#' : url(item.url)}
        data-solitude-action={item.children ? 'noop' : item.action}
        data-solitude-prevent={
          item.children || item.action ? 'true' : undefined
        }
      >
        {item.icon && <i class={`solitude ${item.icon}`} />}
        <span>{item.name}</span>
      </a>
      {item.children && (
        <ul class="menus_item_child tw:[#nav_.menus\_items_.menus\_item_&]:absolute tw:[#nav_.menus\_items_.menus\_item_&]:whitespace-nowrap tw:[#sidebar_#sidebar-menus_.menus\_items_&]:flex tw:[#sidebar_#sidebar-menus_.menus\_items_&]:flex-row tw:[#sidebar_#sidebar-menus_.menus\_items_&]:flex-wrap">
          {item.children.map((child) => (
            <li>
              <a
                class="site-page child tw:[#nav_&]:relative tw:[#nav_&]:cursor-pointer tw:[#sidebar_#sidebar-menus_.menus\_items_&]:relative tw:[#sidebar_#sidebar-menus_.menus\_items_&]:block tw:[#sidebar_#sidebar-menus_.menus\_items_&]:cursor-pointer tw:[#sidebar_#sidebar-menus_.menus\_items_.menus\_item_>_&]:flex"
                href={child.action ? '#' : url(child.url)}
                data-solitude-action={child.action}
                data-solitude-prevent={child.action ? 'true' : undefined}
              >
                {child.icon && <i class={`solitude ${child.icon}`} />}
                <span>{child.name}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  ))}
</div>
