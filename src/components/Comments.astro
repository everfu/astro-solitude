---
import { cfg, t } from '../lib/site';
interface Props {
  enabled?: boolean;
}
const { enabled = true } = Astro.props;
---

{enabled && cfg.comment.use && (
  <section id="post-comment">
    <div class="comment-head">
      <div class="comment-headline">
        <i class="solitude fas fa-comments" />
        <span>{t('comments')}</span>
      </div>
    </div>
    <div class="comment-wrap">
      {cfg.comment.use
        .split(',')
        .map((name) => name.trim())
        .map((name) =>
          name === 'giscus' ? (
            <div class="comment-item giscus-comment" />
          ) : name === 'twikoo' ? (
            <div class="comment-item" id="twikoo" />
          ) : name === 'waline' ? (
            <div class="comment-item" id="waline-wrap" />
          ) : name === 'valine' ? (
            <div
              class:list={[
                'comment-item vcomment',
                { 'valine-theme-style': cfg.valine.style },
              ]}
              id="vcomment"
            />
          ) : name === 'artalk' ? (
            <div class="comment-item" id="artalk-wrap" />
          ) : null,
        )}
    </div>
  </section>
)}
