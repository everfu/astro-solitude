---
import { cfg, t, url, termPath } from '../lib/site';
---

{cfg.search.enable &&
  (cfg.search.type === 'docsearch' ? (
    <div class="docsearch-wrap">
      <div id="docsearch" hidden />
    </div>
  ) : (
    <>
      <div
        id={cfg.search.type === 'algolia' ? 'algolia-search' : 'local-search'}
      >
        <div
          class="search-dialog"
          role="dialog"
          aria-modal="true"
          aria-labelledby="search-dialog-title"
        >
          <nav class="search-nav">
            <span class="search-dialog-title" id="search-dialog-title">
              {t('search')}
            </span>
            <button
              class="search-close-button"
              type="button"
              aria-label={t('close')}
            >
              <i class="solitude fas fa-xmark" />
            </button>
          </nav>
          {cfg.search.type === 'algolia' ? (
            <>
              <div id="algolia-input-panel">
                <div id="algolia-search-input" />
              </div>
              <div id="search-results">
                <div id="algolia-hits">
                  {cfg.search.tags.map((tag: string) => (
                    <a class="tag-list" href={url(termPath('tags', tag))}>
                      {tag}
                    </a>
                  ))}
                </div>
              </div>
              <div id="algolia-tips">
                <div id="algolia-pagination" />
                <div id="algolia-stats" />
              </div>
            </>
          ) : (
            <div class="search-wrap">
              <div class="search-box">
                <input
                  class="search-box-input local-search-box--input"
                  id="search-input"
                  type="search"
                  autocomplete="off"
                  spellcheck="false"
                  placeholder={t('searchPlaceholder')}
                  aria-label={t('search')}
                />
              </div>
              <div id="search-suggestions">
                {cfg.search.tags.map((tag: string) => (
                  <button class="tag-list" type="button" data-query={tag}>
                    {tag}
                  </button>
                ))}
              </div>
              <ul class="local-hits" id="search-results" hidden />
              <nav id="search-pagination" aria-label={t('search')} />
              <div
                id="search-tips"
                role="status"
                aria-live="polite"
                aria-atomic="true"
              />
            </div>
          )}
        </div>
      </div>
      <div id="search-mask" />
    </>
  ))}
